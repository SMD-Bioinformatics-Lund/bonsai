// Local resource and storage overlay for the pinned, benign reference-strain pilot.
// Biological analysis options remain those of upstream's Illumina E. coli profile.
def pilotRoot = System.getenv('JASEN_PILOT_DATA') ?: '/home/jakob/data/codex/jasen'
def pilotRun = "${pilotRoot}/runs/2026-11-08-bonsai-reference-pilot"
def pilotAssets = "${pilotRoot}/analyses/bonsai-integration/2026-11-08-k12-pilot/assets"

workDir = "${pilotRun}/work"
params {
    outdir = "${pilotRun}/output"
    tracedir = "${pilotRun}/pipeline_info"
    workDir = "${pilotRun}/work"
    assets_dir = pilotAssets
    containers_dir = "${pilotRoot}/containers/jasen-1.4.1"
    csv = "${pilotRun}/samples.csv"
    executor = 'local'
    queue = null
    scratch = false
    offline = true
    cron_dir = null
    log_file_dir = "${pilotRun}/completion"
    symlink_dir = "${pilotRun}/output"
    amrfinder_db = "${pilotAssets}/amrfinder_db/latest"
    gambit_db = "${pilotAssets}/gambit_db"
    resfinder_db = "${pilotAssets}/resfinder_db"
    pointfinder_db = "${pilotAssets}/pointfinder_db"
    serotypefinder_db = "${pilotAssets}/serotypefinder_db"
    virulencefinder_db = "${pilotAssets}/virulencefinder_db"
    plasmidfinder_db = "${pilotAssets}/plasmidfinder_db"
    // Use the pinned MLST container's bundled public database for this pilot.
    // Live credentialed PubMLST snapshots are not substituted silently.
    mlst_blast_db = null
    pubmlst_db = null
    hostile_dir = null
    kraken_db = null
    emmtyper_db = null
    tbdb = null
    reference_genome = "${pilotAssets}/genomes/escherichia_coli/GCF_000005845.2.fasta"
    reference_genome_fai = "${pilotAssets}/genomes/escherichia_coli/GCF_000005845.2.fasta.fai"
    reference_genome_idx = "${pilotAssets}/genomes/escherichia_coli/GCF_000005845.2.fasta.fai"
    reference_genome_gff = "${pilotAssets}/genomes/escherichia_coli/GCF_000005845.2.gff"
    core_loci_bed = "${pilotAssets}/wgmlst/escherichia_coli/bed/GCF_000005845.2.bed"
    chewbbaca_db = "${pilotAssets}/wgmlst/escherichia_coli/alleles/ecoli_INNUENDO_wgMLST"
    training_file = "${pilotAssets}/wgmlst/escherichia_coli/alleles/ecoli_INNUENDO_wgMLST/Escherichia_coli.trn"
}

process.resourceLimits = [cpus:4, memory:18.GB]
executor {
    cpus = 4
    memory = 18.GB
    queueSize = 1
}
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${pilotRoot}/caches/singularity"
}
