{
  "name": "bonsai",
  "description": "",
  "version": "1.0.0",
  "sideEffects": [
    "web/js/components/**/*.ts",
    "web/js/utils/choice-select.ts"
  ],
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "choices.js": "^11.1.0",
    "data": "^1.0.0",
    "datatables.net-bs5": "^2.3.8",
    "datatables.net-buttons-bs5": "^3.2.6",
    "datatables.net-columncontrol-bs5": "^1.2.1",
    "datatables.net-datetime": "^1.5.5",
    "datatables.net-searchbuilder-bs5": "^1.8.2",
    "datatables.net-searchpanes-bs5": "^2.3.3",
    "datatables.net-select-bs5": "^3.0.0",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9",
    "eslint": "^10.10.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1",
    "webpack-manifest-plugin": "^6.0.1"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch --output-path bonsai_app/static/build",
    "buildcp": "webpack && cp -v -r build/ bonsai_app/static",
    "lint": "eslint web",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "npx prettier web",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "typecheck": "npx tsc --noEmit",
    "sync": "npm run typecheck && npm run buildcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMD-Bioinformatics-Lund/bonsai.git"
  },
  "keywords": [
    "wgs",
    "antibiotic-resistance",
    "outbreak"
  ],
